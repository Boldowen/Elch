# Local Compose defaults. Staging/production must inject separate values.
NODE_ENV=development
POSTGRES_DB=elch
POSTGRES_USER=ventour
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://ventour:change_me@postgres:5432/elch?schema=public
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:8081
FEATURE_COMMUNITY_ENABLED=false
FEATURE_REVIEWS_ENABLED=true
FEATURE_GUIDE_RANKING_ENABLED=false
# These remain disabled until a real provider/upload workflow is implemented.
FEATURE_IMAGE_UPLOAD_ENABLED=false
FEATURE_ONLINE_PAYMENT_ENABLED=false
EMAIL_FROM=verify@example.com
RESEND_API_KEY=
EMAIL_VERIFICATION_URL=elch://verify-email
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_URL=elch://reset-password
PASSWORD_RESET_COOLDOWN_SECONDS=60
GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
APPLE_CLIENT_IDS=mn.elch.app
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# AI_PROVIDER=local|anthropic|openai. `local` is the safe no-key default.
AI_PROVIDER=anthropic
# Model values are `provider:model` references (anthropic:, openai:, compat:);
# a bare name uses AI_PROVIDER. Modes A/B use DEFAULT, C-E use ADVANCED, and
# safety intents always use SAFETY. Example thesis arms: DEFAULT=compat:<base
# open-weight model>, ADVANCED=compat:<LoRA adapter>; production: all anthropic.
AI_DEFAULT_MODEL=anthropic:claude-opus-5
AI_ADVANCED_MODEL=anthropic:claude-opus-5
AI_SAFETY_MODEL=anthropic:claude-opus-5
AI_ALLOWED_MODELS=
# Claude (official Anthropic SDK). Keep the key in .env only, never in Git.
ANTHROPIC_API_KEY=
# Claude model for classification/assessment scoring when an arm routes elsewhere.
ANTHROPIC_MODEL=claude-opus-5
# Optional: low|medium|high|xhigh|max (empty = API default).
ANTHROPIC_EFFORT=
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_TIMEOUT_MS=120000
# Server-side refusal fallback (`fallbacks: "default"`) on models that support it.
ANTHROPIC_REFUSAL_FALLBACK=true
# OpenAI-compatible endpoint (vLLM/Ollama) serving the fine-tuned model: a
# Kaggle tunnel, a rented GPU or the project's own server - only this URL changes.
AI_COMPAT_BASE_URL=
AI_COMPAT_API_KEY=
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Embeddings are independent of the chat model (Claude has no embedding API):
# auto|local|openai|compat. `compat` calls AI_EMBEDDING_BASE_URL/embeddings.
AI_EMBEDDING_PROVIDER=auto
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EXPERIMENT_MODE=E
AI_ALLOW_EXPERIMENT_OVERRIDE=false
AI_MAX_INPUT_LENGTH=8000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_TOOL_ROUNDS=2
AI_TIMEOUT_MS=30000
AI_STEP_TIMEOUT_MS=20000
AI_TOOL_TIMEOUT_MS=10000
AI_FIRST_CHUNK_TIMEOUT_MS=15000
AI_CHUNK_TIMEOUT_MS=10000
AI_RETRY_ATTEMPTS=1
AI_HISTORY_MAX_MESSAGES=30
AI_HISTORY_MAX_CHARS=24000
AI_RESPONSE_CACHE_TTL_SECONDS=60
AI_RESPONSE_CACHE_MAX_ENTRIES=200
# Fallback prices (USD per million tokens) for models without a built-in price;
# Claude models are priced automatically, including prompt-cache reads/writes.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_DAILY_REQUEST_LIMIT=100
LIVE_DATA_MODE=disabled
LIVE_DATA_TIMEOUT_MS=8000
LIVE_DATA_RETRY_ATTEMPTS=1
LIVE_DATA_CACHE_TTL_SECONDS=300
LIVE_DATA_CACHE_MAX_ENTRIES=500
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
ROAD_CLOSURE_API_URL=
ROAD_CLOSURE_API_KEY=
PERMIT_API_URL=
PERMIT_API_KEY=
TRANSPORT_API_URL=
TRANSPORT_API_KEY=
RAG_TOP_K=6
RAG_MIN_SCORE=0.15
RAG_CANDIDATE_LIMIT=5000
ROUTE_GRAPH_ALLOW_STATIC_FALLBACK=false
GUIDE_LANGUAGE_MIN_CEFR=B2
GUIDE_MATCH_LANGUAGE_WEIGHT=25
GUIDE_MATCH_ROUTE_WEIGHT=25
GUIDE_MATCH_COMPETENCY_WEIGHT=20
GUIDE_MATCH_EXPERIENCE_WEIGHT=10
GUIDE_MATCH_FIRST_AID_WEIGHT=10
GUIDE_MATCH_RATING_WEIGHT=10
ROUTE_REPAIR_ATTEMPTS=1
RESEARCH_EXPORT_ENABLED=true
RESEARCH_EXPORT_SALT=replace-with-a-random-secret-at-least-16-characters
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.data/uploads
STORAGE_MAX_FILE_BYTES=5242880
# For S3-compatible private storage, set STORAGE_DRIVER=s3 and configure these.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=elch-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
