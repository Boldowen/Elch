generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TRAVELER
  GUIDE
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum GuideStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum GuideVerificationDecision {
  APPROVED
  REJECTED
}

enum VerificationCheckStatus {
  PENDING
  VERIFIED
  FAILED
  NOT_PROVIDED
}

enum UserModerationStatus {
  ACTIVE
  TEMPORARILY_SUSPENDED
  PERMANENTLY_SUSPENDED
}

enum ReportReason {
  SPAM
  HARASSMENT
  SCAM
  UNSAFE_GUIDE_BEHAVIOR
  FAKE_LISTING
  INAPPROPRIATE_CONTENT
  PAYMENT_FRAUD
  OTHER
}

enum ReportTargetType {
  USER
  LISTING
  GUIDE
  POST
  MESSAGE
  BOOKING
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  REPORT_DISMISS
  CONTENT_REMOVE
  WARNING
  TEMPORARY_SUSPENSION
  PERMANENT_SUSPENSION
  LISTING_UNPUBLISH
  GUIDE_VERIFICATION_REVOKE
}

enum PaymentArrangement {
  CASH_ON_ARRIVAL
  BANK_TRANSFER
  PROVIDER_TERMINAL
  ONLINE_PAYMENT
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  AGREED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum ListingCategory {
  TRENDING
  HOTEL
  FOODS
  NATURE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum PriceUnit {
  PER_NIGHT
  PER_HOUR
  PER_DAY
  PER_PERSON
  PER_GROUP
  PACKAGE
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED_BY_TRAVELER
  CANCELLED_BY_PROVIDER
  EXPIRED
  NO_SHOW
  DISPUTED
  REFUND_PENDING
  REFUNDED
}

enum BookingActorType {
  TRAVELER
  PROVIDER
  SYSTEM
  ADMIN
}

enum CancellationPolicyType {
  FLEXIBLE
  MODERATE
  STRICT
  CUSTOM
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_ACCEPTED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  BOOKING_STARTED
  BOOKING_COMPLETED
  BOOKING_EXPIRED
  NEW_MESSAGE
  GUIDE_APPLICATION_APPROVED
  GUIDE_APPLICATION_REJECTED
}

enum PricingType {
  HOURLY
  PACKAGE
  NONE
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  email          String       @unique
  passwordHash   String?
  name           String
  phone          String?
  avatarUrl      String?
  provider       AuthProvider @default(EMAIL)
  providerSubject String?
  roles          Role[]       @default([TRAVELER])
  isVerified     Boolean      @default(false)
  emailVerifiedAt DateTime?
  moderationStatus UserModerationStatus @default(ACTIVE)
  suspendedUntil DateTime?
  suspensionReason String?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  refreshTokens  RefreshToken[]
  guideProfile   GuideProfile?
  listings       Listing[]    @relation("ListingHost")
  bookings       Booking[]    @relation("TravelerBookings")
  guidedBookings Booking[]    @relation("GuideBookings")
  favorites      Favorite[]
  participants   ConversationParticipant[]
  messages       Message[]
  paymentMethods PaymentMethod[]
  reviewsWritten Review[]     @relation("ReviewAuthor")
  reviewsReceived Review[]    @relation("ReviewGuide")
  posts          Post[]
  postLikes      PostLike[]
  postComments   PostComment[]
  following      Follow[]     @relation("Following")
  followers      Follow[]     @relation("Followers")
  bookingEvents  BookingEvent[]
  idempotencyKeys IdempotencyKey[]
  notifications  Notification[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  guideVerificationReviews GuideVerificationReview[] @relation("GuideVerificationReviewer")
  blocksCreated UserBlock[] @relation("Blocker")
  blocksReceived UserBlock[] @relation("Blocked")
  reportsCreated Report[] @relation("ReportReporter")
  moderationActions ModerationAction[] @relation("ModerationAdmin")
  paymentArrangementsProposed PilotPayment[] @relation("PaymentProposer")

  @@index([deletedAt])
  @@index([createdAt])
  @@unique([provider, providerSubject])
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String
  family     String   @db.Uuid
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([family])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  sentAt    DateTime @default(now())
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  requestedAt DateTime @default(now())
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([expiresAt])
}

model GuideProfile {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @unique @db.Uuid
  country         String
  city            String
  bio             String
  experienceYears Int          @default(0)
  languages       Json
  expertise       String[]
  availability    String[]
  pricingType     PricingType  @default(HOURLY)
  price           Decimal?     @db.Decimal(10, 2)
  status          GuideStatus  @default(DRAFT)
  verified        Boolean      @default(false)
  assessmentScore Int          @default(0)
  referenceContact String?
  codeOfConductAccepted Boolean @default(false)
  rankPoints      Int          @default(100)
  completedTrips  Int          @default(0)
  responseRate    Int          @default(100)
  acceptanceRate  Int          @default(100)
  providerCancellationCount Int @default(0)
  confirmedReportCount Int     @default(0)
  rankingUpdatedAt DateTime?
  rating          Decimal      @default(0) @db.Decimal(3, 2)
  reviewCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationReviews GuideVerificationReview[]

  @@index([status, deletedAt])
  @@index([city])
  @@index([rankPoints, rating])
}

model GuideVerificationReview {
  id                    String                    @id @default(uuid()) @db.Uuid
  guideProfileId        String                    @db.Uuid
  reviewerId            String                    @db.Uuid
  decision              GuideVerificationDecision
  decisionReason        String?
  internalNote          String?
  assessmentScore       Int
  assessmentBreakdown   Json
  documentStatus        VerificationCheckStatus
  referenceStatus       VerificationCheckStatus
  applicationSnapshot   Json
  reviewedAt            DateTime                  @default(now())
  guideProfile          GuideProfile              @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  reviewer              User                      @relation("GuideVerificationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([guideProfileId, reviewedAt])
  @@index([reviewerId, reviewedAt])
}

model Listing {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  title       String
  location    String
  description String
  category    ListingCategory
  price       Decimal         @db.Decimal(10, 2)
  basePriceMinor Int
  cleaningFeeMinor Int       @default(0)
  serviceFeeMinor Int        @default(0)
  taxMinor    Int             @default(0)
  extraGuestFeeMinor Int     @default(0)
  depositMinor Int            @default(0)
  currency    String          @default("USD") @db.VarChar(3)
  priceUnit   PriceUnit
  datesLabel  String
  tags        String[]
  amenities   String[]
  rating      Decimal         @default(0) @db.Decimal(3, 2)
  reviewCount Int             @default(0)
  published   Boolean         @default(true)
  status      ListingStatus   @default(PUBLISHED)
  defaultTotalUnits Int       @default(1)
  hostId      String          @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  host        User            @relation("ListingHost", fields: [hostId], references: [id])
  images      ListingImage[]
  bookings    Booking[]
  favorites   Favorite[]
  inventory   ListingInventory[]
  reviews     Review[]

  @@index([category, published, deletedAt])
  @@index([location])
  @@index([rating])
}

model ListingInventory {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @db.Uuid
  date           DateTime @db.Date
  totalUnits     Int
  reservedUnits  Int      @default(0)
  availableUnits Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([date, availableUnits])
}

model ListingImage {
  id        String  @id @default(uuid()) @db.Uuid
  url       String
  alt       String?
  sortOrder Int     @default(0)
  listingId String  @db.Uuid
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model Booking {
  id           String        @id @default(uuid()) @db.Uuid
  travelerId   String        @db.Uuid
  guideId      String?       @db.Uuid
  listingId    String?       @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  guests       Int           @default(1)
  amount       Decimal       @db.Decimal(10, 2)
  amountMinor  Int
  baseAmountMinor Int
  cleaningFeeMinor Int       @default(0)
  serviceFeeMinor Int        @default(0)
  taxMinor     Int            @default(0)
  extraGuestFeeMinor Int     @default(0)
  depositMinor Int            @default(0)
  currency     String        @default("USD")
  status       BookingStatus @default(PENDING)
  note         String?
  expiresAt    DateTime?
  cancellationPolicy CancellationPolicyType @default(FLEXIBLE)
  freeCancellationUntil DateTime?
  lateCancellationPercent Int @default(0)
  noShowPercent Int @default(100)
  cancellationFee Decimal @default(0) @db.Decimal(10, 2)
  cancellationFeeMinor Int @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cancelledAt  DateTime?
  deletedAt    DateTime?
  traveler     User          @relation("TravelerBookings", fields: [travelerId], references: [id])
  guide        User?         @relation("GuideBookings", fields: [guideId], references: [id])
  listing      Listing?      @relation(fields: [listingId], references: [id])
  conversation Conversation?
  events       BookingEvent[]
  review       Review?
  payment      PilotPayment?

  @@index([travelerId, startsAt])
  @@index([guideId, status])
  @@index([listingId])
  @@index([status, expiresAt])
  @@index([status, startsAt])
  @@index([status, endsAt])
}

model PilotPayment {
  id                   String             @id @default(uuid()) @db.Uuid
  bookingId            String             @unique @db.Uuid
  arrangement          PaymentArrangement
  status               PaymentStatus      @default(PENDING)
  instructions         String?
  proposedById         String             @db.Uuid
  agreedByTravelerAt   DateTime?
  agreedByProviderAt   DateTime?
  paidAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  booking              Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proposedBy           User               @relation("PaymentProposer", fields: [proposedById], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
  @@index([proposedById])
}

model BookingEvent {
  id         String           @id @default(uuid()) @db.Uuid
  bookingId  String           @db.Uuid
  actorId    String?          @db.Uuid
  actorType  BookingActorType
  fromStatus BookingStatus?
  toStatus   BookingStatus
  eventType  String
  reason     String?
  metadata   Json?
  createdAt  DateTime         @default(now())
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([actorId])
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @db.Uuid
  userId       String   @db.Uuid
  requestHash  String
  responseBody Json?
  statusCode   Int?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model Conversation {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String?  @unique @db.Uuid
  title        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  booking      Booking? @relation(fields: [bookingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  mutedAt        DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id          String           @id @default(uuid()) @db.Uuid
  reporterId  String           @db.Uuid
  reason      ReportReason
  targetType  ReportTargetType
  targetId    String           @db.Uuid
  details     String?
  status      ReportStatus     @default(OPEN)
  resolution  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?
  reporter    User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  actions     ModerationAction[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
}

model ModerationAction {
  id          String               @id @default(uuid()) @db.Uuid
  reportId    String               @db.Uuid
  adminId     String               @db.Uuid
  action      ModerationActionType
  reason      String
  metadata    Json?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  report      Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  admin       User                 @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@index([adminId, createdAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  type           MessageType  @default(TEXT)
  body           String?
  mediaUrl       String?
  sentAt         DateTime     @default(now())
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, sentAt])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

model PaymentMethod {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  providerRef String
  brand       String
  last4       String
  expMonth    Int
  expYear     Int
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  deletedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerRef])
  @@index([userId, isDefault])
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String?  @unique @db.Uuid
  authorId  String   @db.Uuid
  guideId   String?  @db.Uuid
  listingId String?  @db.Uuid
  rating    Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  guide     User?    @relation("ReviewGuide", fields: [guideId], references: [id])
  listing   Listing? @relation(fields: [listingId], references: [id])
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([guideId, createdAt])
  @@index([listingId, createdAt])
}

model Post {
  id        String        @id @default(uuid()) @db.Uuid
  authorId  String        @db.Uuid
  text      String
  location  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images    PostImage[]
  likes     PostLike[]
  comments  PostComment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
}

model PostImage {
  id        String @id @default(uuid()) @db.Uuid
  postId    String @db.Uuid
  url       String
  sortOrder Int    @default(0)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}
