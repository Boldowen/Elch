model User {
  id             String       @id @default(uuid()) @db.Uuid
  email          String       @unique
  passwordHash   String?
  name           String
  phone          String?
  avatarUrl      String?
  provider       AuthProvider @default(EMAIL)
  providerSubject String?
  roles          Role[]       @default([TRAVELER])
  isVerified     Boolean      @default(false)
  emailVerifiedAt DateTime?
  moderationStatus UserModerationStatus @default(ACTIVE)
  suspendedUntil DateTime?
  suspensionReason String?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  refreshTokens  RefreshToken[]
  guideProfile   GuideProfile?
  listings       Listing[]    @relation("ListingHost")
  bookings       Booking[]    @relation("TravelerBookings")
  guidedBookings Booking[]    @relation("GuideBookings")
  favorites      Favorite[]
  participants   ConversationParticipant[]
  messages       Message[]
  paymentMethods PaymentMethod[]
  reviewsWritten Review[]     @relation("ReviewAuthor")
  reviewsReceived Review[]    @relation("ReviewGuide")
  posts          Post[]
  postLikes      PostLike[]
  postComments   PostComment[]
  following      Follow[]     @relation("Following")
  followers      Follow[]     @relation("Followers")
  bookingEvents  BookingEvent[]
  idempotencyKeys IdempotencyKey[]
  notifications  Notification[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  guideVerificationReviews GuideVerificationReview[] @relation("GuideVerificationReviewer")
  blocksCreated UserBlock[] @relation("Blocker")
  blocksReceived UserBlock[] @relation("Blocked")
  reportsCreated Report[] @relation("ReportReporter")
  moderationActions ModerationAction[] @relation("ModerationAdmin")
  paymentArrangementsProposed PilotPayment[] @relation("PaymentProposer")
  assessmentAttempts AssessmentAttempt[] @relation("AssessmentUser")
  assessmentReviews AssessmentReview[] @relation("AssessmentReviewer")
  guideCompetenciesVerified GuideCompetency[] @relation("GuideCompetencyVerifier")
  guideLanguageAssessmentsVerified GuideLanguageAssessment[] @relation("GuideLanguageAssessmentVerifier")
  guideFirstAidRecordsVerified GuideFirstAid[] @relation("GuideFirstAidVerifier")
  aiConversations AiConversation[]
  aiExperimentRuns AiExperimentRun[]
  aiEvaluationReviews AiEvaluationResult[] @relation("AiEvaluationReviewer")
  guideMatchRuns GuideMatchRun[]
  safetyPlansCreated SafetyPlan[] @relation("SafetyPlanCreator")
  safetyPlansReviewed SafetyPlan[] @relation("SafetyPlanReviewer")
  safetyPlanAuditEntries SafetyPlanAudit[] @relation("SafetyPlanAuditActor")
  tourismSourcesReviewed TourismSource[] @relation("TourismSourceReviewer")

  @@index([deletedAt])
  @@index([createdAt])
  @@unique([provider, providerSubject])
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String
  family     String   @db.Uuid
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([family])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  sentAt    DateTime @default(now())
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  requestedAt DateTime @default(now())
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([expiresAt])
}

model GuideProfile {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @unique @db.Uuid
  country         String
  city            String
  bio             String
  experienceYears Int          @default(0)
  languages       Json
  expertise       String[]
  availability    String[]
  pricingType     PricingType  @default(HOURLY)
  price           Decimal?     @db.Decimal(10, 2)
  status          GuideStatus  @default(DRAFT)
  verified        Boolean      @default(false)
  legalRole       GuideLegalRole @default(UNVERIFIED)
  routeBadges     String[]     @default([])
  specialtySkills String[]     @default([])
  firstAidVerified Boolean     @default(false)
  languageEstimate Json?
  assessmentScore Int          @default(0)
  referenceContact String?
  codeOfConductAccepted Boolean @default(false)
  rankPoints      Int          @default(100)
  completedTrips  Int          @default(0)
  responseRate    Int          @default(100)
  acceptanceRate  Int          @default(100)
  providerCancellationCount Int @default(0)
  confirmedReportCount Int     @default(0)
  rankingUpdatedAt DateTime?
  rating          Decimal      @default(0) @db.Decimal(3, 2)
  reviewCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationReviews GuideVerificationReview[]
  evidence        GuideEvidence[]
  competencyAttempts CompetencyAttempt[]
  competencies    GuideCompetency[]
  languageAssessments GuideLanguageAssessment[]
  knowledgeAssessments GuideKnowledgeAssessment[]
  skillAssessments GuideSkillAssessment[]
  routeCompetencies GuideRouteCompetency[]
  firstAidRecords GuideFirstAid[]
  assessmentAttempts AssessmentAttempt[]
  matchResults GuideMatchResult[]
  safetyPlans SafetyPlan[]

  @@index([status, deletedAt])
  @@index([city])
  @@index([rankPoints, rating])
}

model GuideEvidence {
  id             String                  @id @default(uuid()) @db.Uuid
  guideProfileId String                  @db.Uuid
  type           GuideEvidenceType
  issuer         String
  reference      String?
  verifiedAt     DateTime?
  expiresAt      DateTime?
  status         VerificationCheckStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  guideProfile   GuideProfile            @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  @@index([guideProfileId, type, status])
  @@index([expiresAt])
}

model CompetencyAttempt {
  id             String             @id @default(uuid()) @db.Uuid
  guideProfileId String             @db.Uuid
  taskType       CompetencyTaskType
  routeId        String?
  rubricVersion  String
  aiScore        Decimal            @db.Decimal(5, 2)
  humanScores    Json?
  confidence     Decimal            @db.Decimal(4, 3)
  breakdown      Json
  passed         Boolean
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  guideProfile   GuideProfile       @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)

  @@index([guideProfileId, taskType, createdAt])
  @@index([routeId, passed])
}

/// A provenance record for knowledge, route, and assessment content. Authority is
/// platform metadata and must not be presented as an endorsement by the source.
model TourismSource {
  id                  String                    @id @default(uuid()) @db.Uuid
  title               String
  organization        String
  sourceType          TourismSourceType
  authorityLevel      TourismAuthorityLevel
  url                 String
  language            String                    @db.VarChar(16)
  publishedAt         DateTime?
  validFrom           DateTime?
  validTo             DateTime?
  licenseOrUsageNote  String
  reviewStatus        TourismSourceReviewStatus @default(PENDING)
  reviewedAt          DateTime?
  reviewedById        String?                   @db.Uuid
  reviewNotes         String?
  lastVerifiedAt      DateTime
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  knowledge           TourismKnowledge[]
  routes              ResearchRoute[]
  routeNodes          RouteNode[]
  routeEdges          RouteEdge[]
  assessmentQuestions AssessmentQuestion[]
  reviewedBy          User?                     @relation("TourismSourceReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([authorityLevel, lastVerifiedAt])
  @@index([reviewStatus, lastVerifiedAt])
  @@index([reviewedById, reviewedAt])
  @@index([organization])
  @@index([validTo])
}

model TourismKnowledge {
  id                 String                     @id @default(uuid()) @db.Uuid
  sourceId           String                     @db.Uuid
  title              String
  content            String
  contentHash        String                     @db.VarChar(64)
  chunkIndex         Int                        @default(0)
  region             String?
  routeFamily        RouteFamily?
  category           TourismKnowledgeCategory
  language           String                     @db.VarChar(16)
  embedding          Json?
  embeddingReference String?
  embeddingModel     String?
  tokenCount         Int?
  metadata           Json?
  active             Boolean                    @default(true)
  lastVerifiedAt     DateTime
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  source             TourismSource              @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, contentHash, language])
  @@index([routeFamily, category, language, active])
  @@index([region, language, active])
  @@index([lastVerifiedAt])
}

model ResearchRoute {
  id                 String                   @id @default(uuid()) @db.Uuid
  sourceId           String?                  @db.Uuid
  code               String                   @unique
  name               String
  routeFamily        RouteFamily
  description        String
  minimumDays        Int
  recommendedDays    Int
  riskLevel          RouteRiskLevel
  minimumLanguageLevel CefrLevel               @default(B2)
  routeBadge         String
  firstAidRequired   Boolean                    @default(true)
  requiredGuideLegalRole GuideLegalRole         @default(LICENSED_PROFESSIONAL_GUIDE)
  requiredSpecialtySkills String[]              @default([])
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  source             TourismSource?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  nodes              RouteNode[]
  edges              RouteEdge[]
  guideCompetencies  GuideCompetency[]
  routeCompetencies  GuideRouteCompetency[]
  assessmentAttempts AssessmentAttempt[]
  experimentRuns     AiExperimentRun[]
  guideMatchRuns     GuideMatchRun[]
  safetyPlans        SafetyPlan[]

  @@index([routeFamily, active])
  @@index([riskLevel, active])
}

model RouteNode {
  id                  String          @id @default(uuid()) @db.Uuid
  routeId             String          @db.Uuid
  sourceId            String?         @db.Uuid
  destinationId       String?
  code                String
  name                String
  nameMn              String
  nameEn              String
  region              String
  latitude            Decimal         @db.Decimal(9, 6)
  longitude           Decimal         @db.Decimal(9, 6)
  altitude            Int?
  nodeType            RouteNodeType
  sequenceHint        Int?
  minimumVisitMinutes Int             @default(0)
  seasonalityMetadata Json?
  accessMetadata      Json?
  safetyMetadata      Json?
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  route               ResearchRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  source              TourismSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  outgoingEdges       RouteEdge[]      @relation("RouteEdgeFromNode")
  incomingEdges       RouteEdge[]      @relation("RouteEdgeToNode")

  @@unique([routeId, code])
  @@index([routeId, sequenceHint])
  @@index([destinationId])
}

model RouteEdge {
  id                         String             @id @default(uuid()) @db.Uuid
  routeId                    String             @db.Uuid
  fromNodeId                 String             @db.Uuid
  toNodeId                   String             @db.Uuid
  sourceId                   String             @db.Uuid
  code                       String
  transportMode              RouteTransportMode
  distanceKm                 Decimal            @db.Decimal(9, 2)
  estimatedTravelMinutes     Int
  estimatedCostMinor         Int?
  estimatedCostCurrency      String?            @db.VarChar(3)
  terrain                    String?
  riskLevel                  RouteRiskLevel
  seasonality                Json?
  bidirectional              Boolean            @default(false)
  requiresRoadCheck          Boolean            @default(false)
  requiresWeatherCheck       Boolean            @default(false)
  requiresPermitCheck        Boolean            @default(false)
  requiresGuide              Boolean            @default(false)
  requiredGuideCompetencies  String[]           @default([])
  emergencyPlanRequired      Boolean            @default(false)
  active                     Boolean            @default(true)
  lastVerifiedAt             DateTime
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  route                      ResearchRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromNode                   RouteNode          @relation("RouteEdgeFromNode", fields: [fromNodeId], references: [id], onDelete: Restrict)
  toNode                     RouteNode          @relation("RouteEdgeToNode", fields: [toNodeId], references: [id], onDelete: Restrict)
  source                     TourismSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([routeId, fromNodeId, toNodeId, transportMode])
  @@unique([routeId, code])
  @@index([routeId, active])
  @@index([fromNodeId, toNodeId])
  @@index([riskLevel, active])
  @@index([lastVerifiedAt])
}

/// Human-reviewed operational plan required before R3/R4 travel validation can
/// pass. Decisions are append-only in SafetyPlanAudit and never inferred from
/// client-provided booleans.
model SafetyPlan {
  id                    String                 @id @default(uuid()) @db.Uuid
  routeId               String                 @db.Uuid
  createdById           String                 @db.Uuid
  guideProfileId        String                 @db.Uuid
  reviewedById          String?                @db.Uuid
  title                 String
  tripStartAt           DateTime
  tripEndAt             DateTime
  riskLevelSnapshot     RouteRiskLevel
  itinerary             Json
  emergencyContacts     Json
  communicationsPlan    String
  evacuationPlan        String
  medicalPlan           String
  riskMitigations       Json
  equipmentChecklist    Json
  permitReferences      Json?
  status                SafetyPlanStatus       @default(DRAFT)
  version               Int                    @default(1)
  submittedAt           DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  revokedAt             DateTime?
  expiresAt             DateTime?
  reviewNotes           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  route                 ResearchRoute          @relation(fields: [routeId], references: [id], onDelete: Restrict)
  createdBy             User                   @relation("SafetyPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  guideProfile          GuideProfile           @relation(fields: [guideProfileId], references: [id], onDelete: Restrict)
  reviewedBy            User?                  @relation("SafetyPlanReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  auditEntries          SafetyPlanAudit[]

  @@index([createdById, status, createdAt])
  @@index([routeId, status, tripStartAt])
  @@index([guideProfileId, status])
  @@index([status, expiresAt])
}

/// Append-only decision log. The migration installs a database trigger that
/// rejects UPDATE and DELETE so audit history remains immutable outside NestJS.
model SafetyPlanAudit {
  id             String                  @id @default(uuid()) @db.Uuid
  safetyPlanId   String                  @db.Uuid
  actorId        String?                 @db.Uuid
  action         SafetyPlanAuditAction
  fromStatus     SafetyPlanStatus?
  toStatus       SafetyPlanStatus
  planVersion    Int
  snapshot       Json
  reason         String?
  createdAt      DateTime                @default(now())
  safetyPlan     SafetyPlan              @relation(fields: [safetyPlanId], references: [id], onDelete: Restrict)
  actor          User?                   @relation("SafetyPlanAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([safetyPlanId, createdAt])
  @@index([actorId, createdAt])
}

model GuideCompetency {
  id                 String                  @id @default(uuid()) @db.Uuid
  guideProfileId     String                  @db.Uuid
  routeId            String?                 @db.Uuid
  assessmentAttemptId String?                @db.Uuid
  competencyType     GuideCompetencyType
  competencyCode     String
  score              Decimal                 @db.Decimal(5, 2)
  status             GuideCompetencyStatus   @default(NOT_ASSESSED)
  verifiedById       String?                 @db.Uuid
  verificationMethod String?
  validFrom          DateTime?
  validTo            DateTime?
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  guideProfile       GuideProfile            @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  route              ResearchRoute?          @relation(fields: [routeId], references: [id], onDelete: SetNull)
  assessmentAttempt  AssessmentAttempt?      @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  verifiedBy         User?                   @relation("GuideCompetencyVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([guideProfileId, competencyType, status])
  @@index([competencyCode, status, validTo])
  @@index([routeId, status])
}

model GuideLanguageAssessment {
  id                   String                  @id @default(uuid()) @db.Uuid
  guideProfileId       String                  @db.Uuid
  assessmentAttemptId  String?                 @unique @db.Uuid
  language             String                  @db.VarChar(32)
  officialEvidenceType String?
  officialEvidenceValue String?
  aiEstimatedCefr      CefrLevel?
  aiConfidence         Decimal?                @db.Decimal(4, 3)
  fluencyScore         Decimal?                @db.Decimal(5, 2)
  grammarScore         Decimal?                @db.Decimal(5, 2)
  vocabularyScore      Decimal?                @db.Decimal(5, 2)
  interactionScore     Decimal?                @db.Decimal(5, 2)
  clarityScore         Decimal?                @db.Decimal(5, 2)
  humanVerifiedCefr    CefrLevel?
